# Supabase
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=service_role_key
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=anon_key

# Discord
DISCORD_BOT_TOKEN=your_bot_token
DISCORD_CHANNEL_ID=000000000000000000

# LLM
ANTHROPIC_API_KEY=your_anthropic_key

# Gateway / SDK
AGENTGATE_GATEWAY_URL=http://localhost:8000
GATE_SHARED_SECRET=changeme

# Razorpay (optional — when set, execute_purchase creates a real Razorpay test order
# instead of returning a mock receipt). Use TEST keys; the key id starts with rzp_test_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Local LLM (optional - when set, sensitive=True tools route their output through
# a local Ollama instance for PII-stripping. Without it the SDK falls back to a
# deterministic regex redactor. Both backends are fully local - no cloud traffic.
# Setup: install Ollama, then `ollama pull llama3.2 && ollama serve`.
LOCAL_LLM_URL=http://localhost:11434
LOCAL_LLM_MODEL=llama3.2
